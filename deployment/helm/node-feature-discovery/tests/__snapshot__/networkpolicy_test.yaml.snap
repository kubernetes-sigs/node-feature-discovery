matches the snapshot when enabled with default values:
  1: |
    apiVersion: networking.k8s.io/v1
    kind: NetworkPolicy
    metadata:
      labels:
        app.kubernetes.io/instance: nfd
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/name: node-feature-discovery
        app.kubernetes.io/version: v0.0.0-test
        helm.sh/chart: node-feature-discovery-0.0.0-test
        role: master
      name: nfd-node-feature-discovery-master-network-policy
      namespace: nfd-system
    spec:
      egress:
        - ports:
            - port: 80
              protocol: TCP
            - port: 443
              protocol: TCP
            - port: 53
              protocol: TCP
            - port: 53
              protocol: UDP
            - port: 6443
              protocol: TCP
      ingress:
        - ports:
            - port: http
              protocol: TCP
      podSelector:
        matchLabels:
          app.kubernetes.io/instance: nfd
          app.kubernetes.io/name: node-feature-discovery
          role: master
      policyTypes:
        - Egress
        - Ingress
