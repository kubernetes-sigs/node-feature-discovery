matches the snapshot with default values:
  1: |
    apiVersion: apps/v1
    kind: Deployment
    metadata:
      labels:
        app.kubernetes.io/instance: nfd
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/name: node-feature-discovery
        app.kubernetes.io/version: v0.0.0-test
        helm.sh/chart: node-feature-discovery-0.0.0-test
        role: gc
      name: nfd-node-feature-discovery-gc
      namespace: nfd-system
    spec:
      replicas: 1
      revisionHistoryLimit: null
      selector:
        matchLabels:
          app.kubernetes.io/instance: nfd
          app.kubernetes.io/name: node-feature-discovery
          role: gc
      template:
        metadata:
          labels:
            app.kubernetes.io/instance: nfd
            app.kubernetes.io/name: node-feature-discovery
            role: gc
        spec:
          containers:
            - args:
                - -gc-interval=1h
                - -port=8080
              command:
                - nfd-gc
              env:
                - name: NODE_NAME
                  valueFrom:
                    fieldRef:
                      fieldPath: spec.nodeName
              image: registry.k8s.io/nfd/node-feature-discovery:v0.0.0-test
              imagePullPolicy: Always
              livenessProbe:
                httpGet:
                  path: /healthz
                  port: http
                initialDelaySeconds: 10
              name: gc
              ports:
                - containerPort: 8080
                  name: http
              readinessProbe:
                httpGet:
                  path: /healthz
                  port: http
                initialDelaySeconds: 5
              resources:
                limits:
                  memory: 1Gi
                requests:
                  cpu: 10m
                  memory: 128Mi
              securityContext:
                allowPrivilegeEscalation: false
                capabilities:
                  drop:
                    - ALL
                readOnlyRootFilesystem: true
                runAsNonRoot: true
          dnsPolicy: ClusterFirstWithHostNet
          hostNetwork: false
          imagePullSecrets: null
          securityContext: {}
          serviceAccountName: nfd-node-feature-discovery-gc
