matches the snapshot with default values:
  1: |
    apiVersion: v1
    kind: ServiceAccount
    metadata:
      annotations:
        helm.sh/hook: post-delete
        helm.sh/hook-delete-policy: before-hook-creation,hook-succeeded
      labels:
        app.kubernetes.io/instance: nfd
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/name: node-feature-discovery
        app.kubernetes.io/version: v0.0.0-test
        helm.sh/chart: node-feature-discovery-0.0.0-test
      name: nfd-node-feature-discovery-prune
      namespace: nfd-system
  2: |
    apiVersion: rbac.authorization.k8s.io/v1
    kind: ClusterRole
    metadata:
      annotations:
        helm.sh/hook: post-delete
        helm.sh/hook-delete-policy: before-hook-creation,hook-succeeded
      labels:
        app.kubernetes.io/instance: nfd
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/name: node-feature-discovery
        app.kubernetes.io/version: v0.0.0-test
        helm.sh/chart: node-feature-discovery-0.0.0-test
      name: nfd-node-feature-discovery-prune
    rules:
      - apiGroups:
          - ""
        resources:
          - nodes
          - nodes/status
        verbs:
          - get
          - patch
          - update
          - list
  3: |
    apiVersion: rbac.authorization.k8s.io/v1
    kind: ClusterRoleBinding
    metadata:
      annotations:
        helm.sh/hook: post-delete
        helm.sh/hook-delete-policy: before-hook-creation,hook-succeeded
      labels:
        app.kubernetes.io/instance: nfd
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/name: node-feature-discovery
        app.kubernetes.io/version: v0.0.0-test
        helm.sh/chart: node-feature-discovery-0.0.0-test
      name: nfd-node-feature-discovery-prune
    roleRef:
      apiGroup: rbac.authorization.k8s.io
      kind: ClusterRole
      name: nfd-node-feature-discovery-prune
    subjects:
      - kind: ServiceAccount
        name: nfd-node-feature-discovery-prune
        namespace: nfd-system
  4: |
    apiVersion: batch/v1
    kind: Job
    metadata:
      annotations:
        helm.sh/hook: post-delete
        helm.sh/hook-delete-policy: before-hook-creation,hook-succeeded
      labels:
        app.kubernetes.io/instance: nfd
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/name: node-feature-discovery
        app.kubernetes.io/version: v0.0.0-test
        helm.sh/chart: node-feature-discovery-0.0.0-test
      name: nfd-node-feature-discovery-prune
      namespace: nfd-system
    spec:
      template:
        metadata:
          labels:
            app.kubernetes.io/instance: nfd
            app.kubernetes.io/managed-by: Helm
            app.kubernetes.io/name: node-feature-discovery
            app.kubernetes.io/version: v0.0.0-test
            helm.sh/chart: node-feature-discovery-0.0.0-test
            role: prune
        spec:
          affinity:
            nodeAffinity:
              preferredDuringSchedulingIgnoredDuringExecution:
                - preference:
                    matchExpressions:
                      - key: node-role.kubernetes.io/control-plane
                        operator: In
                        values:
                          - ""
                  weight: 1
          containers:
            - args:
                - -prune
              command:
                - nfd-master
              image: registry.k8s.io/nfd/node-feature-discovery:v0.0.0-test
              imagePullPolicy: Always
              name: nfd-master
              resources:
                limits:
                  memory: 4Gi
                requests:
                  cpu: 100m
                  memory: 128Mi
              securityContext:
                allowPrivilegeEscalation: false
                capabilities:
                  drop:
                    - ALL
                readOnlyRootFilesystem: true
                runAsNonRoot: true
          imagePullSecrets: null
          restartPolicy: Never
          serviceAccountName: nfd-node-feature-discovery-prune
          tolerations:
            - effect: NoSchedule
              key: node-role.kubernetes.io/control-plane
              operator: Equal
              value: ""
      ttlSecondsAfterFinished: 3600
